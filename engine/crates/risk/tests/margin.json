{
  "units": "price usdc 1e6 per 1 base; size base 1e8 signed (long>0); usdc amounts 1e6",
  "formulas": {
    "notional": "floor(price * |size| / 1e8)",
    "im": "ceil(notional(mark) * imr_bps / 10000)",
    "mm": "ceil(notional(mark) * mmr_bps / 10000)",
    "upnl": "long: notional(mark) - entry_notional; short: entry_notional - notional(mark)",
    "equity": "collateral + upnl"
  },
  "cases": [
    {
      "name": "btc long 1 profit",
      "imr_bps": 500,
      "mmr_bps": 250,
      "collateral": 10000000000,
      "size": 100000000,
      "entry_price": 60000000000,
      "mark_price": 61500000000,
      "expected": {
        "entry_notional": 60000000000,
        "notional": 61500000000,
        "im": 3075000000,
        "mm": 1537500000,
        "upnl": 1500000000,
        "equity": 11500000000
      }
    },
    {
